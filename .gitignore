# GitHub'da yalnızca ders notları, PDF'ler ve Typst kaynakları yer alır.
*

!/.gitignore

!/hafta-??/
!/hafta-??/*.typ
!/hafta-??/*.pdf
!/hafta-??/assets/
!/hafta-??/assets/**

# Sınırı bilinmeyen 2 ve 3. haftalar tek bölümde tutulur.
!/hafta-02-03/
!/hafta-02-03/*.typ
!/hafta-02-03/*.pdf
!/hafta-02-03/assets/
!/hafta-02-03/assets/**

!/bm211-tum-haftalar.typ
!/bm211-tum-haftalar.pdf

# macOS metadata files are not course assets.
**/.DS_Store
**/._*

# El yazısı kaynak taraması yerel referans olarak kalır.
/hafta-??/kaynak.pdf
/hafta-02-03/kaynak.pdf

# notkit
hafta-*/kaynak.pdf
hafta-*/.calisma/
.DS_Store
!/ders.toml
!/_sablon/
!/_sablon/**
/AGENTS.md
/CLAUDE.md
/GEMINI.md
